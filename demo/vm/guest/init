#!/bin/sh
# Galene guest init (runs as PID 1's child under libkrun's init, root = this tree over virtiofs).
# /data is the TPM-sealed volume's data dir: TLS key lives there; a fresh volume means new keys.
export PATH=/bin OPENSSL_CONF=/etc/ssl/openssl.cnf
say() { echo "galene-vm: $*"; }

mount -t proc proc /proc 2>/dev/null
# $1 = host time (epoch seconds): the guest clock starts at zero and a new
# certificate must not be born expired.
[ -n "$1" ] && date -s "@$1" >/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
cd /srv/galene

# libkrun's virtio-net default MTU is 65520; the board routes plain Ethernet. The guest sits on a
# private /30 behind the board (NAT); $2 is the board's address, where clients reach Galene.
ip link set eth0 mtu 1500 up
ip addr add 10.21.0.2/30 dev eth0
ip route add default via 10.21.0.1

if [ ! -s data/key.pem ]; then
	say "[6/7] no TLS key on this volume: generating a new P-256 key + self-signed certificate"
	openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 30 \
		-subj "/CN=ashen-demo" -addext "subjectAltName=DNS:ashen-demo.local,DNS:uno-q.local" \
		-keyout data/key.pem -out data/cert.pem 2>/dev/null || { say "keygen FAILED"; exit 1; }
	chmod 600 data/key.pem
else
	say "[6/7] reusing TLS key from the encrypted volume"
fi
fp=$(openssl x509 -in data/cert.pem -noout -fingerprint -sha256 | cut -d= -f2)
say "TLS certificate SHA-256 fingerprint:"
say "  $fp"
say "[7/7] Galene serving https://$2:8443/"
# Media goes through the board's TURN server (data/ice-servers.json, written by the host).
ulimit -n 65536 2>/dev/null
exec galene -http :8443 -turn "" -data data -groups groups -static static
