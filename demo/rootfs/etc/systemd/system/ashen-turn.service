[Unit]
Description=Ashen: TURN relay for Galene's WebRTC media
After=network-online.target
Wants=network-online.target

[Service]
# coturn listens on the addresses present at start; clients use br0's
ExecStartPre=/bin/sh -c 'for i in $(seq 300); do ip -4 -o addr show br0 | grep -q inet && exit 0; sleep 0.2; done; exit 1'
# per-boot shared secret, also handed to Galene (ice-servers.json)
ExecStartPre=/bin/sh -c 'umask 077; mkdir -p /run/ashen; [ -s /run/ashen/turn-secret ] || head -c 24 /dev/urandom | base64 > /run/ashen/turn-secret'
ExecStart=/bin/sh -c 'exec /usr/bin/turnserver -c /etc/ashen/turnserver.conf --static-auth-secret="$(cat /run/ashen/turn-secret)"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
