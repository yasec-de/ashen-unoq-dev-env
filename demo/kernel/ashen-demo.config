# Ashen demo kernel: merged on top of the running board config (linux/.config of ashen-drv-tpm).
CONFIG_LOCALVERSION="-ashen-demo"
# MCU link, heartbeat alarm, firmware TPM
CONFIG_ASHEN_TAMPER=y
CONFIG_TCG_TPM=y
CONFIG_TCG_ASHEN=y
# CONFIG_TCG_TPM2_HMAC is not set
# Memory tagging handed to the crash kernel
CONFIG_CRASH_DUMP=y
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_MEMACTION=y
CONFIG_CRASH_MEMACTION_DEBUGFS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=0
# krun microVMs
CONFIG_KVM=y
CONFIG_VHOST_VSOCK=m
CONFIG_VIRTIO_VSOCKETS=y
# Encrypted VM volume
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CRYPTO_XTS=y
# Console on the monitor; the msm/anx7625 stack stays modular (loaded from the initrd)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_FOREGROUND_COLOR=0xffffff
CONFIG_DRM_PANIC_BACKGROUND_COLOR=0xcc0000
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
